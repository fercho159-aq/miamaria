# Copia este archivo a .env.local y completa los valores.

# Base de datos (Neon Postgres). Para probar sin base real: npm run dev:local
DATABASE_URL=postgresql://usuario:password@host/neondb?sslmode=require

# Cadena aleatoria de 32+ caracteres para cifrar la sesión del panel
SESSION_SECRET=

# Dominio público (para ligas en los correos)
NEXT_PUBLIC_SITE_URL=https://miamaria.com.mx

# WhatsApp que recibe los pedidos: 52 + 1 + 10 dígitos (formato wa.me), sin espacios
NEXT_PUBLIC_WHATSAPP=5215500000000
NEXT_PUBLIC_INSTAGRAM=

# Aviso por correo de cada pre-orden (Resend: https://resend.com)
RESEND_API_KEY=
PEDIDOS_EMAIL=pedidos@miamaria.com.mx
EMAIL_FROM=Mía María <pedidos@miamaria.com.mx>

# Fotos de producto (Vercel Blob). Sin token se guardan en public/uploads (solo desarrollo)
BLOB_READ_WRITE_TOKEN=
